---
import DefaultTableOfContents from "@astrojs/starlight/components/TableOfContents.astro";
import path from "node:path";
import ReadingProgress from "./ReadingProgress.astro";

const { entry } = Astro.locals.starlightRoute;
const isIntroduction = entry.slug === "get-started/overview";
const repositoryUrl = "https://github.com/superplanehq/docs";
const pageTitle = entry.data.title;
const pagePath = path.relative(process.cwd(), entry.filePath).split(path.sep).join("/");
const encodedPagePath = pagePath.split("/").map(encodeURIComponent).join("/");
const feedbackTitle = encodeURIComponent(`Feedback for ${pageTitle}`);
---

<section class="sidebar-section sidebar-section--actions" aria-labelledby="page-actions">
  <h2 id="page-actions">Actions</h2>
  <div class="action-links">
    <a
      href={`${repositoryUrl}/issues/new?title=${feedbackTitle}`}
      target="_blank"
      rel="noreferrer"
    >
      Give us feedback ↗
    </a>
    <a
      href={`${repositoryUrl}/edit/main/${encodedPagePath}`}
      target="_blank"
      rel="noreferrer"
    >
      Edit this page on GitHub ↗
    </a>
  </div>
</section>

<ReadingProgress />

<DefaultTableOfContents />

{
  isIntroduction && (
    <script is:inline>
      const overviewLink = document.querySelector(
        'starlight-toc a[href="#_top"] span'
      );
      if (overviewLink) overviewLink.textContent = "Introduction";
    </script>
  )
}

<script>
  let titlePanelObserver: ResizeObserver | undefined;

  const syncActionsHeight = () => {
    const titlePanel = document.querySelector<HTMLElement>(
      ".main-pane .content-panel:first-of-type",
    );
    const actions = document.querySelector<HTMLElement>(
      ".sidebar-section--actions",
    );

    if (!titlePanel || !actions) return;

    const titleBottom = titlePanel.getBoundingClientRect().bottom;
    const actionsTop = actions.getBoundingClientRect().top;
    actions.style.setProperty(
      "--actions-height",
      `${Math.max(titleBottom - actionsTop, 0)}px`,
    );
  };

  const observeTitlePanel = () => {
    titlePanelObserver?.disconnect();

    const titlePanel = document.querySelector<HTMLElement>(
      ".main-pane .content-panel:first-of-type",
    );
    if (!titlePanel) return;

    titlePanelObserver = new ResizeObserver(syncActionsHeight);
    titlePanelObserver.observe(titlePanel);
    syncActionsHeight();
  };

  document.addEventListener("astro:page-load", observeTitlePanel);
  observeTitlePanel();
</script>

<style>
  @layer starlight.components {
    .sidebar-section {
      margin: 1.25rem 0 0;
      border-top: 1px solid var(--sl-color-hairline);
      padding: 1.25rem 1rem 0;
    }

    .sidebar-section h2 {
      margin-bottom: 0.75rem;
    }

    .sidebar-section--actions {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: var(--actions-height, 11.125rem);
      margin-top: 0;
      border-top: 0;
      padding: 1rem 1rem 1.5rem;
    }

    .sidebar-section--actions h2 {
      margin: 0 0 0.55rem;
    }

    .action-links {
      display: grid;
      gap: 0.2rem;
    }

    .sidebar-section--actions a {
      padding-block: 0.15rem;
      overflow-wrap: anywhere;
    }

    .sidebar-section a {
      padding-block: 0.25rem;
    }

    .sidebar-section p {
      margin: 0 0 0.6rem;
      color: var(--sl-color-gray-4);
      font-size: var(--sl-text-xs);
    }

  }
</style>
