---
import config from "virtual:starlight/user-config";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";

const shouldRenderSearch =
  config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<div class="header">
  <div class="left-group sl-flex">
    <div class="title-wrapper sl-flex"><SiteTitle /></div>
    {/* Careers link intentionally hidden while there are no open roles. */}
  </div>

  <div class="right-group print:hidden">
    {shouldRenderSearch && <div class="search-slot sl-flex"><Search /></div>}
    <div class="social-icons sl-hidden md:sl-flex"><SocialIcons /></div>
    <LanguageSelect />
  </div>
</div>

<dialog id="video-walkthrough-dialog" class="walkthrough-dialog" aria-labelledby="video-walkthrough-title">
  <form method="dialog">
    <div class="walkthrough-dialog__eyebrow">Video walkthrough</div>
    <h2 id="video-walkthrough-title">Coming soon</h2>
    <p>We are preparing a guided tour of the complete Factory flow. Use the written quickstart while the video is in production.</p>
    <div class="walkthrough-dialog__actions">
      <a href="/get-started/quickstart">Read the quickstart</a>
      <button value="close">Close</button>
    </div>
  </form>
</dialog>

<script>
  const walkthroughDialog = document.querySelector<HTMLDialogElement>("#video-walkthrough-dialog");

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const walkthroughLink = target.closest<HTMLAnchorElement>('a[href*="#video-walkthrough"]');
    if (!walkthroughLink || !walkthroughDialog) return;

    event.preventDefault();
    walkthroughDialog.showModal();
  });

  walkthroughDialog?.addEventListener("click", (event) => {
    if (event.target === walkthroughDialog) walkthroughDialog.close();
  });
</script>

<style>
  @layer starlight.components {
    .header,
    .left-group,
    .right-group,
    .social-icons {
      display: flex;
      align-items: center;
    }

    .header {
      justify-content: space-between;
      gap: 1rem;
      height: 100%;
    }

    .left-group {
      min-width: 0;
      gap: 1.25rem;
    }

    .title-wrapper {
      min-width: 0;
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
    }

    .right-group {
      justify-content: flex-end;
      gap: 1rem;
      min-width: 0;
      margin-inline-start: auto;
    }

    .search-slot {
      width: clamp(13rem, 28vw, 22rem);
    }

    .social-icons {
      gap: 1rem;
    }

    .walkthrough-dialog {
      width: min(31rem, calc(100vw - 2rem));
      margin: auto;
      border: 1px solid var(--sp-color-border);
      border-radius: 0.75rem;
      padding: 0;
      color: var(--sp-color-text-secondary);
      background: var(--sp-color-surface);
      box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 0.55);
    }

    .walkthrough-dialog::backdrop {
      background: rgb(9 10 10 / 0.78);
      backdrop-filter: blur(5px);
    }

    .walkthrough-dialog form {
      padding: 1.5rem;
    }

    .walkthrough-dialog__eyebrow {
      color: var(--sp-color-yellow);
      font-size: var(--sl-text-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .walkthrough-dialog h2 {
      margin-block: 0.55rem 0.5rem;
      color: var(--sp-color-ivory);
      font-size: 1.65rem;
    }

    .walkthrough-dialog p {
      margin: 0;
      color: var(--sp-color-text-muted);
      line-height: 1.6;
    }

    .walkthrough-dialog__actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .walkthrough-dialog__actions a,
    .walkthrough-dialog__actions button {
      border: 1px solid var(--sp-color-border);
      border-radius: 0.4rem;
      padding: 0.65rem 0.85rem;
      font: inherit;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
    }

    .walkthrough-dialog__actions a {
      border-color: var(--sp-color-yellow);
      color: var(--sp-color-black);
      background: var(--sp-color-yellow);
    }

    .walkthrough-dialog__actions button {
      color: var(--sp-color-text-secondary);
      background: transparent;
    }

    .walkthrough-dialog__actions a:hover,
    .walkthrough-dialog__actions a:focus-visible {
      background: var(--sp-color-yellow-soft);
    }

    .walkthrough-dialog__actions button:hover,
    .walkthrough-dialog__actions button:focus-visible {
      border-color: var(--sp-color-text-dim);
      color: var(--sp-color-ivory);
    }

    @media (max-width: 49.999rem) {
      .header {
        gap: 0.75rem;
      }

      .left-group {
        flex: 1 1 auto;
        overflow: hidden;
      }

      .title-wrapper {
        flex: 1 1 auto;
      }

      .right-group {
        flex: 0 0 auto;
        margin-inline-start: 0;
      }

      .search-slot {
        flex: 0 0 2.75rem;
        width: 2.75rem;
        max-width: 2.75rem;
      }
    }

    @media (max-width: 30rem) {
      .header,
      .right-group {
        gap: 0.5rem;
      }

      .walkthrough-dialog form {
        padding: 1.1rem;
      }

      .walkthrough-dialog__actions {
        align-items: stretch;
        flex-direction: column;
      }

      .walkthrough-dialog__actions a,
      .walkthrough-dialog__actions button {
        width: 100%;
        text-align: center;
      }
    }
  }
</style>
